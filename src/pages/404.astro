---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/alquiler.css';

const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Equipos en alquiler', href: `${base}#equipos` },
  { label: 'Modalidades de alquiler y arrendamiento', href: `${base}#modalidades` },
  { label: 'Preguntas frecuentes', href: `${base}#preguntas` },
  { label: 'Solicitar cotización', href: `${base}#cotizacion` },
];
---

<Layout
  title="Página no encontrada · ARAR"
  description="La página que busca no existe o cambió de dirección. Vuelva al inicio de ARAR o solicite una cotización de alquiler de equipos."
  noindex
>
  <Header />
  <main class="rl nf" id="contenido">
    <section class="rl-section">
      <div class="container nf__inner">
        <p class="rl-eyebrow">Error 404</p>
        <h1 class="rl-title">
          No encontramos esta página.
          <span class="rl-accent">Pero sí los equipos que busca.</span>
        </h1>
        <p class="rl-lead">
          La dirección no existe o cambió con la nueva versión del sitio. Estas son las secciones más consultadas:
        </p>
        <ul class="nf__links">
          {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
        <a href={base} class="rl-btn rl-btn--primary">Ir al inicio</a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .nf {
    padding-top: 96px;
  }
  .nf__inner {
    display: grid;
    gap: 24px;
    justify-items: start;
    max-width: 760px;
  }
  .nf__links {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .nf__links a {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
